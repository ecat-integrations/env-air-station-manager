<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ecat.integration.EnvAirStationManagerIntegration.mapper.AsmAlarmRecordMapper">

    <!-- 报警记录行；时间列 timestamptz 走 TimestamptzInstantTypeHandler；type FQCN（非 BaseEntity 短别名不注册）。 -->
    <resultMap type="com.ecat.integration.EnvAirStationManagerIntegration.domain.AsmAlarmRecord" id="AsmAlarmRecordResult">
        <id property="id" column="id"/>
        <result property="alarmType"           column="alarm_type"/>
        <result property="ruleName"            column="rule_name"/>
        <result property="logicDeviceUniqueId" column="logic_device_unique_id"/>
        <result property="attrId"              column="attr_id"/>
        <result property="severity"            column="severity"/>
        <result property="startTime"           column="start_time" typeHandler="com.ecat.integration.EnvAirStationManagerIntegration.support.TimestamptzInstantTypeHandler"/>
        <result property="endTime"             column="end_time" typeHandler="com.ecat.integration.EnvAirStationManagerIntegration.support.TimestamptzInstantTypeHandler"/>
        <result property="description"         column="description"/>
        <result property="status"              column="status"/>
        <result property="lastBreachTime"      column="last_breach_time" typeHandler="com.ecat.integration.EnvAirStationManagerIntegration.support.TimestamptzInstantTypeHandler"/>
        <result property="resultContent"       column="result_content"/>
        <result property="createdAt"           column="created_at" typeHandler="com.ecat.integration.EnvAirStationManagerIntegration.support.TimestamptzInstantTypeHandler"/>
    </resultMap>

    <sql id="allColumns">
        id, alarm_type, rule_name, logic_device_unique_id, attr_id, severity,
        start_time, end_time, description, status, last_breach_time, result_content, created_at
    </sql>

    <!-- episode 区间重叠窗口谓词（单一真相源）：查询窗左开右闭 (start, end]——end 时刻触发的算本期、
         恰在 start 闭单的归上期，连续分窗（上窗 end=下窗 start）每条报警恰好命中一次（无缝无重）；
         等价于报警 episode 与开区间时刻集 (start, end] 有交集即命中。end_time 为 null 的 ACTIVE 行
         （持续中）不受比较约束天然命中。REST 列表（selectList/countList）与 SDK
         （selectEntriesByType）共用本片段，禁各自内联副本（bug-record-20260911-200004：列表曾
         分叉 end_time-only 锚点，默认视图滤掉持续中报警）。 -->
    <sql id="overlapWindow">
        start_time &lt;= #{end}
        and (end_time is null or end_time &gt; #{start})
    </sql>

    <!-- episode 落行（bug-record-20260902-183355 修复）：ACTIVE 行 end_time=null（活跃中无结束时刻，
         评估器不置值）；恢复行（POWER 恢复路径）评估器已置 endTime——曾硬编码 null 把它丢弃，致恢复行
         默认列表不可见、recover_time/duration_ms 恒 null，已按实体值落列（两种行同一 insert）。 -->
    <insert id="insert" parameterType="com.ecat.integration.EnvAirStationManagerIntegration.domain.AsmAlarmRecord"
            useGeneratedKeys="true" keyProperty="id">
        insert into asm_alarm_record
            (alarm_type, rule_name, logic_device_unique_id, attr_id, severity,
             start_time, end_time, description, status, last_breach_time, result_content, created_at)
        values
            (#{alarmType}, #{ruleName}, #{logicDeviceUniqueId}, #{attrId}, #{severity},
             #{startTime, typeHandler=com.ecat.integration.EnvAirStationManagerIntegration.support.TimestamptzInstantTypeHandler},
             #{endTime, typeHandler=com.ecat.integration.EnvAirStationManagerIntegration.support.TimestamptzInstantTypeHandler},
             #{description}, #{status},
             #{lastBreachTime, typeHandler=com.ecat.integration.EnvAirStationManagerIntegration.support.TimestamptzInstantTypeHandler},
             #{resultContent}, now())
    </insert>

    <select id="selectActive" resultMap="AsmAlarmRecordResult">
        select <include refid="allColumns"/>
        from asm_alarm_record
        where logic_device_unique_id = #{logicDeviceUniqueId}
          and attr_id = #{attrId}
          and alarm_type = #{alarmType}
          and status = 'ACTIVE'
        limit 1
    </select>

    <update id="extendActive">
        update asm_alarm_record
        set last_breach_time = #{lastBreachTime, typeHandler=com.ecat.integration.EnvAirStationManagerIntegration.support.TimestamptzInstantTypeHandler}
        where id = #{id} and status = 'ACTIVE'
    </update>

    <select id="selectAllActive" resultMap="AsmAlarmRecordResult">
        select <include refid="allColumns"/>
        from asm_alarm_record
        where status = 'ACTIVE'
    </select>

    <update id="closeBatch">
        update asm_alarm_record
        set status = 'INACTIVE',
            end_time = #{now, typeHandler=com.ecat.integration.EnvAirStationManagerIntegration.support.TimestamptzInstantTypeHandler}
        where status = 'ACTIVE'
          and id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <!-- 列表窗口口径 = overlapWindow 共享片段（与 SDK 同源，见片段注释）：ACTIVE 行（持续中）
         默认视图天然命中；status/uid 仅作追加过滤，不参与窗口分叉。排序锚 COALESCE——已恢复行按
         恢复时刻、活跃行按最近续期时刻降序（持续报警自动浮顶）。 -->
    <select id="selectList" resultMap="AsmAlarmRecordResult">
        select <include refid="allColumns"/>
        from asm_alarm_record
        where <include refid="overlapWindow"/>
        <if test="logicDeviceUniqueId != null">
          and logic_device_unique_id = #{logicDeviceUniqueId}
        </if>
        <if test="status != null">
          and status = #{status}
        </if>
        order by COALESCE(end_time, last_breach_time) desc
        limit #{limit}
    </select>

    <select id="countList" resultType="long">
        select count(*)
        from asm_alarm_record
        where <include refid="overlapWindow"/>
        <if test="logicDeviceUniqueId != null">
          and logic_device_unique_id = #{logicDeviceUniqueId}
        </if>
        <if test="status != null">
          and status = #{status}
        </if>
    </select>

    <!-- SDK 按报警标识 + 时间窗查询：episode 区间重叠（窗口谓词收敛到 overlapWindow 共享片段，
         语义详见片段注释——修复旧 end_time 落窗锚点查不出持续中的缺陷后成单一真相源）。 -->
    <select id="selectEntriesByType" resultMap="AsmAlarmRecordResult">
        select <include refid="allColumns"/>
        from asm_alarm_record
        where alarm_type = #{alarmType}
          and <include refid="overlapWindow"/>
        order by start_time desc
        limit #{limit}
    </select>

    <!-- SDK 报警标识目录：asm_alarm_rule 全量三列投影（ruleName 在 setting_content JSON 内，服务层
         经规则定义解析并坏行隔离）；partial resultMap 只映射目录所需列（id/时刻列不取）。 -->
    <resultMap type="com.ecat.integration.EnvAirStationManagerIntegration.domain.AsmAlarmRule" id="AsmAlarmTypeCatalogResult">
        <result property="alarmType"      column="alarm_type"/>
        <result property="severity"       column="severity"/>
        <result property="settingContent" column="setting_content"/>
    </resultMap>
    <select id="selectTypeCatalog" resultMap="AsmAlarmTypeCatalogResult">
        select alarm_type, severity, setting_content
        from asm_alarm_rule
        order by alarm_type
    </select>
</mapper>
